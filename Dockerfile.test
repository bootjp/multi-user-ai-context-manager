FROM postgres:17-bookworm AS postgres-tools
FROM golang:1.25-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 liblz4-1 libzstd1 && rm -rf /var/lib/apt/lists/*
COPY --from=postgres-tools /usr/lib/postgresql/17 /usr/lib/postgresql/17
ENV TEST_PG_BIN=/usr/lib/postgresql/17/bin
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
CMD ["go", "test", "-race", "-count=1", "-v", "./..."]
